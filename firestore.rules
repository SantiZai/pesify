rules_version = '2';

// Reglas de Firestore para Pesify: cada usuario solo accede a los datos de
// las familias donde su UID está en `members`, y a transacciones de esas
// familias. Pegar en Firebase Console > Firestore Database > Reglas > Publicar.
//
// Notas:
// - `families/{id}` permite lectura a cualquier usuario logueado porque el id
//   ES el código de invitación (unirse requiere verificar que existe).
// - `users/{uid}` permite leer perfiles ajenos (para mostrar miembros) pero
//   solo cada uno escribe su propio documento.
// - Las escrituras encoladas offline se validan contra estas reglas al sincronizar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyMembers(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    function isFamilyMember(familyId) {
      return signedIn() && (request.auth.uid in familyMembers(familyId));
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /families/{familyId} {
      allow get: if signedIn();
      // Listar solo las propias (para cambiar entre familias).
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      // Crear con uno mismo como miembro, o unirse (quedar en `members`).
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in request.resource.data.members;
      // Borrar (en cascada desde la app, con datos ya eliminados).
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /transactions/{txId} {
      allow read: if isFamilyMember(resource.data.familyId);
      // Crear por uno mismo o por otro miembro (la app genera recurrencias
      // con el autor de la regla aunque la abra otro integrante).
      allow create: if isFamilyMember(request.resource.data.familyId)
        && request.resource.data.createdBy in familyMembers(request.resource.data.familyId)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['income', 'expense'];
      // No se permite mover una transacción de familia ni cambiar su autor.
      allow update: if isFamilyMember(resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isFamilyMember(resource.data.familyId);
    }

    match /recurring/{ruleId} {
      allow read: if isFamilyMember(resource.data.familyId);
      allow create: if isFamilyMember(request.resource.data.familyId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['income', 'expense'];
      allow update: if isFamilyMember(resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.createdBy == resource.data.createdBy;
      // Borrar conserva el historial ya generado.
      allow delete: if isFamilyMember(resource.data.familyId);
    }

    match /categories/{categoryId} {
      allow read: if isFamilyMember(resource.data.familyId);
      allow create: if isFamilyMember(request.resource.data.familyId);
      // No se permite mover una categoría de familia.
      allow update: if isFamilyMember(resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId;
      // El borrado con movimientos en uso lo bloquea la app.
      allow delete: if isFamilyMember(resource.data.familyId);
    }

    match /budgets/{budgetId} {
      allow read: if isFamilyMember(resource.data.familyId);
      allow create, update: if isFamilyMember(request.resource.data.familyId)
        && request.resource.data.limit is number
        && request.resource.data.limit > 0;
      allow delete: if isFamilyMember(resource.data.familyId);
    }

    // Cuentas fijas del mes (impuestos y gastos por pagar).
    match /planned_bills/{billId} {
      allow read: if isFamilyMember(resource.data.familyId);
      allow create, update: if isFamilyMember(request.resource.data.familyId);
      allow delete: if isFamilyMember(resource.data.familyId);
    }

    match /savings_goals/{goalId} {
      // El doc puede no existir (sin meta): resource null se permite.
      allow get: if resource == null || isFamilyMember(resource.data.familyId);
      allow list: if false;
      allow create, update: if isFamilyMember(request.resource.data.familyId)
        && request.resource.data.goal is number
        && request.resource.data.goal > 0;
      allow delete: if isFamilyMember(resource.data.familyId);
    }

    // Viajes: el código de invitación es el id. Pueden participar invitados
    // que no son de la familia (cualquiera con el código puede unirse).
    match /trips/{tripId} {
      // El id ES el código: cualquiera logueado puede leer un viaje si lo conoce.
      allow get: if signedIn();
      allow list: if signedIn()
        && (request.auth.uid in resource.data.participants
          || request.auth.uid in get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.members);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.auth.uid in get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.members;
      allow update: if signedIn()
        && (request.auth.uid in resource.data.participants
          || request.auth.uid in request.resource.data.participants
          || request.auth.uid in get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.members);
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /trip_expenses/{expenseId} {
      allow read: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.participants;
      allow create: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.participants
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.participants;
      allow delete: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.participants;
    }
  }
}
